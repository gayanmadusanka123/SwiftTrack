      "PaymentSucceeded":"swifttrack.payment.succeeded",
      "PaymentFailed":"swifttrack.payment.failed",
      "ReservationExpired":"swifttrack.inventory.reservation-expired"
    }
  },
  "ServiceUrls":{
    "InventoryService": "",
    "VerificationService" : ""
  },
  "AllowedHosts": "*"
}
